# ── Supabase (recommended for production) ────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI assistant (server-only) ────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOCAL_AUTH_SECRET=change-me-to-a-long-random-string
APP_ORIGIN=

# Local fallback database path (development only)
# LOCAL_DB_PATH=./data/lifeos.db

# ── Frontend API base (optional; defaults to same-origin /api) ────────────
VITE_API_BASE_URL=
